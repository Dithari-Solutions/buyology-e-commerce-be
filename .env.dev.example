# ─── DEV environment for docker-compose.dev.yml ───────────────────────────────
# Filled with DEV-ONLY values for testing the repair feature. Copy this whole file
# to `.env.dev` on the dev server:
#     cp .env.dev.example .env.dev
#     docker compose -f docker-compose.dev.yml --env-file .env.dev up -d --build
# NOTE: this now contains secrets — do NOT `git commit` it. Real per-env secrets
# belong in `.env.dev` (gitignored), never in a tracked file.

# ── Where the app binds on the VPS ──
# 0.0.0.0 = reachable on the box's IP:8080 for a quick HTTP smoke test.
# If you front it with nginx + TLS on a dev domain, use APP_BIND=127.0.0.1.
APP_BIND=0.0.0.0
APP_PORT=8080

# ── Schema: `update` creates/updates all tables (incl. the phase-2 repair tables)
#    on the fresh dev DB. Keep it on `update` for dev. ──
HIBERNATE_DDL_AUTO=update

# ── Postgres (the dev container CREATES this user + db fresh on first boot) ──
DB_USERNAME=ecommerce_user
DB_PASSWORD=change-me-dev-db-password

# ── RabbitMQ (dev container creates it) ──
RABBITMQ_USERNAME=buyology_dev
RABBITMQ_PASSWORD=change-me-dev-rabbit-password

# ── Auth (DEV-ONLY) ──
JWT_SECRET=change-me-run-openssl-rand-base64-48
MFA_SECRET_ENCRYPTION_KEY=
MFA_ENABLED=false
# Seeds the first SUPERADMIN on the fresh dev DB — log into the dashboard with these.
BOOTSTRAP_ADMIN_EMAIL=dev-admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-dev-admin-password

# ── Cookies / CORS / URLs ──
# COOKIE_SECURE=false works for a plain-HTTP smoke test / API calls. For the web UI
# login (HttpOnly refresh cookie) to work cross-site you need HTTPS → set true behind
# nginx+TLS. Put your dev frontend origins in CORS_ALLOWED_ORIGINS.
COOKIE_SECURE=false
TRUST_FORWARDED_HEADERS=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
WEB_BASE_URL=http://localhost:3000
DASHBOARD_BASE_URL=http://localhost:5173

# ── SendGrid (blank = no emails on dev; repair still works, just no email notifications) ──
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@buyology.online

# ── OAuth (blank = disabled; log in with the bootstrap admin / a registered user) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=

# ── Paymob — left BLANK (not testing the courier-fee payment). The app boots fine;
#    only the "request courier" legs need these. Use the free store drop-off /
#    store pickup options to exercise the rest of the repair flow. ──
PAYMOB_BASE_URL=https://uae.paymob.com
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_NOTIFICATION_URL=
PAYMOB_REDIRECTION_URL=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_CARD_IFRAME_ID=
PAYMOB_TABBY_INTEGRATION_ID=
PAYMOB_TAMARA_INTEGRATION_ID=

# ── Twilio — SmsService calls Twilio.init() at startup, which rejects blank creds,
#    so these are dummy-but-non-blank just to boot. No SMS is sent during repair
#    testing. VERIFY_SERVICE_SID stays blank (phone OTP disabled on dev). ──
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=00000000000000000000000000000000
TWILIO_PHONE_NUMBER=+10000000000
TWILIO_VERIFY_SERVICE_SID=

# ── Contabo S3 — needed ONLY to upload repair images. The ENDPOINT must be a valid
#    URL or the app won't boot (the S3 client validates it), so it's pre-filled with
#    a dummy endpoint + placeholder keys: the app boots, and you can submit repairs
#    WITHOUT images. To test photo upload, replace the ACCESS/SECRET/BUCKET/PUBLIC_URL
#    with a SEPARATE DEV bucket's real credentials. ──
CONTABO_S3_ENDPOINT=https://usc1.contabostorage.com
CONTABO_S3_ACCESS_KEY=dev-placeholder
CONTABO_S3_SECRET_KEY=dev-placeholder
CONTABO_S3_BUCKET_NAME=buyology-dev
CONTABO_S3_PUBLIC_URL=https://usc1.contabostorage.com/buyology-dev

# ── Claude API — AI repair price estimate from the customer's photos + description,
#    priced for the UAE market in AED and converted for display by CurrencyExchangeService.
#    LEAVE BLANK to disable: the repair flow works exactly as before, just with no AI
#    suggestion. The estimate is ADVISORY — the repair team still sends the binding price.
#    Get a key at console.anthropic.com → API keys. ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
REPAIR_AI_ESTIMATE_ENABLED=true

# ── Courier service proxy — CourierServiceTokenProvider is an eager @Component whose
#    constructor THROWS on a blank key, so this is a throwaway dev RSA key (base64 PEM,
#    single line) purely so the app boots. Not used by the repair feature. ──
COURIER_SERVICE_PRIVATE_KEY=
