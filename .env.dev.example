# ─── DEV environment for docker-compose.dev.yml ───────────────────────────────
# Copy to `.env.dev` on the dev VPS and fill in DEV-ONLY values. NEVER put prod
# secrets, the prod DB, or prod domains here. `.env.dev` is gitignored — keep it
# off git and off any prod server.
#
#   cp .env.dev.example .env.dev
#   docker compose -f docker-compose.dev.yml --env-file .env.dev up -d --build

# ── Where the app binds on the VPS ──
# Default binds to 127.0.0.1:8080 so you put nginx/Caddy in front for TLS.
# For quick HTTP-only smoke testing on a raw IP, set APP_BIND=0.0.0.0 AND COOKIE_SECURE=false.
APP_BIND=127.0.0.1
APP_PORT=8080

# ── Schema: keep `update` on dev (creates/updates tables incl. the phase-2 repair
#    tables). There is no baseline Flyway migration, so `validate` would fail on a fresh DB. ──
HIBERNATE_DDL_AUTO=update

# ── Postgres (local dev container — its own volume, NOT prod) ──
DB_USERNAME=buyology_dev
DB_PASSWORD=change-me-dev-db-password

# ── RabbitMQ (local dev container) ──
RABBITMQ_USERNAME=buyology_dev
RABBITMQ_PASSWORD=change-me-dev-rabbit-password

# ── Auth (DEV-ONLY — different from prod so dev tokens can't be used on prod) ──
# Generate:  openssl rand -base64 48
JWT_SECRET=change-me-generate-a-long-random-dev-secret-min-64-chars
# Optional; blank => falls back to JWT_SECRET. Generate: openssl rand -base64 32
MFA_SECRET_ENCRYPTION_KEY=
# Keep 2FA off on dev for easy admin login.
MFA_ENABLED=false
# Seeds the first SUPERADMIN on the fresh dev DB (idempotent; blank after first login).
BOOTSTRAP_ADMIN_EMAIL=dev-admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-dev-admin-password

# ── Cookies / CORS / URLs — point at DEV frontends only ──
# COOKIE_SECURE=true requires the dev backend to be served over HTTPS (recommended:
# api-dev.buyology.online behind nginx+Let's Encrypt, mirroring prod). Set false only
# for plain-HTTP smoke testing (cross-site SPA cookie login won't work then).
COOKIE_SECURE=true
TRUST_FORWARDED_HEADERS=true
# Comma-separated dev origins allowed to call the API.
CORS_ALLOWED_ORIGINS=https://dev.buyology.online,https://admin-dev.buyology.online,http://localhost:5173,http://localhost:3000
WEB_BASE_URL=https://dev.buyology.online
DASHBOARD_BASE_URL=https://admin-dev.buyology.online

# ── SendGrid (a dev/test sender is safest; can be blank to disable email) ──
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@buyology.online

# ── OAuth (optional; blank disables. Use DEV client IDs + DEV redirect URIs if used) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=

# ── Paymob — SANDBOX/TEST ACCOUNT ONLY. Required to test the repair courier fee. ──
# The webhook + redirect URLs MUST point at THIS dev host, or Paymob callbacks hit prod.
PAYMOB_BASE_URL=https://uae.paymob.com
PAYMOB_API_KEY=your-paymob-SANDBOX-api-key
PAYMOB_SECRET_KEY=your-paymob-SANDBOX-secret-key
PAYMOB_PUBLIC_KEY=your-paymob-SANDBOX-public-key
PAYMOB_HMAC_SECRET=your-paymob-SANDBOX-hmac-secret
PAYMOB_NOTIFICATION_URL=https://api-dev.buyology.online/api/payments/webhook
PAYMOB_REDIRECTION_URL=https://dev.buyology.online/en/payment/callback
PAYMOB_CARD_INTEGRATION_ID=your-sandbox-card-integration-id
PAYMOB_CARD_IFRAME_ID=your-sandbox-card-iframe-id
PAYMOB_TABBY_INTEGRATION_ID=
PAYMOB_TAMARA_INTEGRATION_ID=

# ── Twilio (blank TWILIO_VERIFY_SERVICE_SID => phone OTP disabled on dev) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# ── Contabo S3 — use a SEPARATE DEV BUCKET so dev uploads never touch prod images ──
CONTABO_S3_ENDPOINT=https://usc1.contabostorage.com
CONTABO_S3_ACCESS_KEY=your-dev-access-key
CONTABO_S3_SECRET_KEY=your-dev-secret-key
CONTABO_S3_BUCKET_NAME=buyology-dev
CONTABO_S3_PUBLIC_URL=https://usc1.contabostorage.com/buyology-dev

# ── Courier service proxy (optional on dev) ──
COURIER_SERVICE_PRIVATE_KEY=
