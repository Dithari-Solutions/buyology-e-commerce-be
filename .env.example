# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# .env must NEVER be committed to git.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Docker ───────────────────────────────────────────────────────────────────
DOCKER_USERNAME=your_dockerhub_username

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_USERNAME=ecommerce_user
DB_PASSWORD=your_db_password

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=your_jwt_secret_key

# ─── Google OAuth2 ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://dev.dithari.com/oauth2/redirect

# ─── SendGrid (email) ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@buyology.online

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=ecommerce-redis
REDIS_PORT=6379

# ─── Cookie ───────────────────────────────────────────────────────────────────
# true for production (HTTPS), false for local HTTP dev
COOKIE_SECURE=true

# ─── Paymob ───────────────────────────────────────────────────────────────────
# Settings → Account Info → API Key
PAYMOB_API_KEY=ZXlKaGJHY2lPaUpJVXpVeE1pSXNJblI1Y0NJNklrcFhWQ0o5LmV5SmpiR0Z6Y3lJNklrMWxjbU5vWVc1MElpd2ljSEp2Wm1sc1pWOXdheUk2TkRRek1Ea3NJbTVoYldVaU9pSnBibWwwYVdGc0luMC5FV3ZVdmVUenFEYy1PZ2p4MDh2WlcwT2NGUFp2aUt1X1d4OWZlbWxxLWZaQ2UxYy00YUo1Tm5pbWI2M2NiZ1ZMbE81VkZielE5QTdTZE1FWEs2ZW9vZw==

