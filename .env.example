# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# .env must NEVER be committed to git.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Docker ───────────────────────────────────────────────────────────────────
DOCKER_USERNAME=your_dockerhub_username

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_USERNAME=ecommerce_user
DB_PASSWORD=your_db_password

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=your_jwt_secret_key

# ─── Google OAuth2 ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://dev.dithari.com/oauth2/redirect

# ─── SendGrid (email) ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@buyology.online

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=ecommerce-redis
REDIS_PORT=6379

# ─── Cookie ───────────────────────────────────────────────────────────────────
# true for production (HTTPS), false for local HTTP dev
COOKIE_SECURE=true

# ─── Paymob ───────────────────────────────────────────────────────────────────
# Settings → Account Info → API Key (legacy — kept for backward compat)
PAYMOB_API_KEY=your_paymob_api_key

# Settings → Account Info → Secret Key (used for all server-side API calls)
PAYMOB_SECRET_KEY=your_paymob_secret_key

# Settings → Account Info → Public Key (used by frontend to open Unified Checkout)
PAYMOB_PUBLIC_KEY=your_paymob_public_key

# Settings → Account Info → HMAC Secret (used to verify webhook signatures)
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret

# UAE region base URL
PAYMOB_BASE_URL=https://uae.paymob.com

# Paymob will POST webhook callbacks to this URL after payment success/failure
# Must be publicly reachable — e.g. https://api.yourdomain.com/api/payments/webhook
PAYMOB_NOTIFICATION_URL=https://your-domain.com/api/payments/webhook

# Developers → Payment Integrations → Card integration → ID column
PAYMOB_CARD_INTEGRATION_ID=your_card_integration_id

# Developers → iFrames → your iframe → ID column (card payments only)
PAYMOB_CARD_IFRAME_ID=your_card_iframe_id

# Developers → Payment Integrations → Tabby integration → ID column
PAYMOB_TABBY_INTEGRATION_ID=your_tabby_integration_id

# Developers → Payment Integrations → Tamara integration → ID column
PAYMOB_TAMARA_INTEGRATION_ID=your_tamara_integration_id

# ─── Twilio (SMS OTP) ─────────────────────────────────────────────────────────
# console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# console.twilio.com → Phone Numbers → Manage → Active Numbers
TWILIO_PHONE_NUMBER=+1your_twilio_number

# ─── Contabo S3 (Object Storage) ──────────────────────────────────────────────
CONTABO_S3_ENDPOINT=https://your-endpoint.contabo.com
CONTABO_S3_ACCESS_KEY=your_access_key
CONTABO_S3_SECRET_KEY=your_secret_key
CONTABO_S3_BUCKET_NAME=your_bucket_name
CONTABO_S3_PUBLIC_URL=https://your-public-url.com
